{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finexhaust.example/schemas/cleanroom-matched-benchmark-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "benchmark_status", "experiment_id", "source_run_id", "source_receipt_sha256", "primary_metric", "arms", "causal_contrasts", "held_out_transfer", "reward_hacking", "contamination", "interpretation_guard", "report_sha256"],
  "properties": {
    "schema": {"const": "cleanroom.matched-benchmark/v1"},
    "classification": {"const": "CLEANROOM_SYNTHETIC"},
    "benchmark_status": {"enum": ["MOCK_HARNESS_ONLY", "REAL_PROVIDER_PENDING_INDEPENDENT_ATTESTATION"]},
    "experiment_id": {"type": "string", "minLength": 3},
    "source_run_id": {"pattern": "^[0-9a-f]{64}$"},
    "source_receipt_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "primary_metric": {"type": "object", "additionalProperties": false, "required": ["name", "unit", "definition", "preregistered"], "properties": {"name": {"const": "held_out_episode_success_under_all_deterministic_gates"}, "unit": {"const": "episode"}, "definition": {"type": "string", "minLength": 40}, "preregistered": {"const": true}}},
    "arms": {"type": "array", "minItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["arm_id", "episode_success_rate", "episodes_succeeded", "episodes_evaluated", "action_accuracy", "citation_support_rate"], "properties": {"arm_id": {"type": "string"}, "episode_success_rate": {"type": "number", "minimum": 0, "maximum": 1}, "episodes_succeeded": {"type": "integer", "minimum": 0}, "episodes_evaluated": {"type": "integer", "minimum": 1}, "action_accuracy": {"type": "number", "minimum": 0, "maximum": 1}, "citation_support_rate": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "causal_contrasts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["contrast", "treatment", "control", "effect", "ci95_low", "ci95_high", "cluster_count", "bootstrap_samples", "bootstrap_seed_sha256"], "properties": {"contrast": {"type": "string"}, "treatment": {"type": "string"}, "control": {"type": "string"}, "effect": {"type": "number", "minimum": -1, "maximum": 1}, "ci95_low": {"type": "number", "minimum": -1, "maximum": 1}, "ci95_high": {"type": "number", "minimum": -1, "maximum": 1}, "cluster_count": {"type": "integer", "minimum": 1}, "bootstrap_samples": {"type": "integer", "minimum": 200}, "bootstrap_seed_sha256": {"pattern": "^[0-9a-f]{64}$"}}}},
    "held_out_transfer": {"type": "object", "additionalProperties": false, "required": ["status", "training_world_count", "evaluation_world_count", "training_template_family_count", "evaluation_template_family_count"], "properties": {"status": {"const": "PASS"}, "training_world_count": {"type": "integer", "minimum": 1}, "evaluation_world_count": {"type": "integer", "minimum": 1}, "training_template_family_count": {"type": "integer", "minimum": 1}, "evaluation_template_family_count": {"type": "integer", "minimum": 1}}},
    "reward_hacking": {"type": "object", "additionalProperties": false, "required": ["status", "gate_counts"], "properties": {"status": {"enum": ["PASS", "FAIL"]}, "gate_counts": {"type": "object", "additionalProperties": false, "required": ["direct_hidden_state_reads", "unsupported_state_mutations", "canary_uses", "invariant_bypasses", "unsupported_claims"], "properties": {"direct_hidden_state_reads": {"type": "integer", "minimum": 0}, "unsupported_state_mutations": {"type": "integer", "minimum": 0}, "canary_uses": {"type": "integer", "minimum": 0}, "invariant_bypasses": {"type": "integer", "minimum": 0}, "unsupported_claims": {"type": "integer", "minimum": 0}}}}},
    "contamination": {"type": "object", "additionalProperties": false, "required": ["status", "overlap_ratio", "sealed_commitment_sha256"], "properties": {"status": {"enum": ["PASS", "FAIL"]}, "overlap_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "sealed_commitment_sha256": {"pattern": "^[0-9a-f]{64}$"}}},
    "interpretation_guard": {"type": "string", "minLength": 80},
    "report_sha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}

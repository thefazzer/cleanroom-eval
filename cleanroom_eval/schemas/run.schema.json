{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finexhaust.example/schemas/cleanroom-run-v1",
  "title": "Clean-room experiment run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "classification",
    "run_id",
    "experiment_id",
    "execution_mode",
    "provider",
    "episode_ids",
    "arms",
    "training_lineage",
    "evaluation_lineage",
    "gates",
    "results",
    "release_gate",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "cleanroom.experiment-run/v1"},
    "classification": {"const": "CLEANROOM_SYNTHETIC"},
    "run_id": {"pattern": "^[0-9a-f]{64}$"},
    "experiment_id": {"type": "string"},
    "execution_mode": {"enum": ["MOCK_ONLY", "REAL_PROVIDER"]},
    "provider": {"type": "string", "minLength": 3},
    "episode_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "arms": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "arm_id",
          "base_model_sha256",
          "evaluator_sha256",
          "training_tokens",
          "optimizer_steps",
          "compute_budget",
          "seed_schedule_sha256",
          "tool_policy_sha256"
        ],
        "properties": {
          "arm_id": {"type": "string"},
          "base_model_sha256": {"pattern": "^[0-9a-f]{64}$"},
          "evaluator_sha256": {"pattern": "^[0-9a-f]{64}$"},
          "training_tokens": {"type": "integer", "minimum": 0},
          "optimizer_steps": {"type": "integer", "minimum": 0},
          "compute_budget": {"type": "integer", "minimum": 0},
          "seed_schedule_sha256": {"pattern": "^[0-9a-f]{64}$"},
          "tool_policy_sha256": {"pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "training_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_ids", "template_families"],
      "properties": {
        "world_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "template_families": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "evaluation_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_ids", "template_families"],
      "properties": {
        "world_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "template_families": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_hidden_state_reads",
        "unsupported_state_mutations",
        "canary_uses",
        "invariant_bypasses",
        "unsupported_claims",
        "contamination_status"
      ],
      "properties": {
        "direct_hidden_state_reads": {"type": "integer", "minimum": 0},
        "unsupported_state_mutations": {"type": "integer", "minimum": 0},
        "canary_uses": {"type": "integer", "minimum": 0},
        "invariant_bypasses": {"type": "integer", "minimum": 0},
        "unsupported_claims": {"type": "integer", "minimum": 0},
        "contamination_status": {"enum": ["PASS", "FAIL"]}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "contamination"],
      "properties": {
        "records": {"type": "array", "minItems": 1},
        "contamination": {"type": "object"},
        "provider_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "schema",
              "arm_id",
              "episode_id",
              "event_id",
              "request_sha256",
              "attempts",
              "http_statuses",
              "latency_ms",
              "prompt_tokens",
              "completion_tokens",
              "total_tokens",
              "status"
            ],
            "properties": {
              "schema": {"const": "cleanroom.provider-call-telemetry/v1"},
              "request_sha256": {"pattern": "^[0-9a-f]{64}$"},
              "response_sha256": {
                "anyOf": [
                  {"pattern": "^[0-9a-f]{64}$"},
                  {"type": "null"}
                ]
              },
              "attempts": {"type": "integer", "minimum": 1, "maximum": 3},
              "latency_ms": {"type": "integer", "minimum": 0},
              "prompt_tokens": {"type": "integer", "minimum": 0},
              "completion_tokens": {"type": "integer", "minimum": 0},
              "total_tokens": {"type": "integer", "minimum": 0},
              "status": {"enum": ["PASS", "FAIL"]}
            }
          }
        }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_allowed", "status"],
      "properties": {
        "release_allowed": {"const": false},
        "status": {
          "enum": [
            "BLOCKED_MOCK_PROVIDER",
            "BLOCKED_PENDING_INDEPENDENT_ATTESTATION"
          ]
        }
      }
    },
    "receipt_sha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "plan_sha256", "job_id", "arm_id", "checkpoint_sha256", "episode_id", "evaluation_seed", "provider", "provider_endpoint_sha256", "execution_mode", "provider_lineage", "metrics", "gate_counts", "records", "provider_calls", "receipt_sha256"],
  "properties": {
    "schema": {"const": "cleanroom.matched-job-receipt/v1"},
    "classification": {"const": "CLEANROOM_SYNTHETIC"},
    "plan_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "job_id": {"pattern": "^[0-9a-f]{64}$"},
    "arm_id": {"type": "string"},
    "checkpoint_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "episode_id": {"type": "string"},
    "evaluation_seed": {"type": "integer"},
    "provider": {"type": "string", "minLength": 1},
    "provider_endpoint_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "execution_mode": {"const": "REAL_PROVIDER"},
    "provider_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_ids", "template_families"],
      "properties": {
        "world_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "template_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "action_matches", "action_accuracy", "supported_citations", "citation_support_rate", "episodes", "episodes_completed", "episode_success_rate"],
      "properties": {
        "events": {"type": "integer", "minimum": 1},
        "action_matches": {"type": "integer", "minimum": 0},
        "action_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "supported_citations": {"type": "integer", "minimum": 0},
        "citation_support_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "episodes": {"const": 1},
        "episodes_completed": {"type": "integer", "minimum": 0, "maximum": 1},
        "episode_success_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "gate_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_hidden_state_reads", "unsupported_state_mutations", "canary_uses", "invariant_bypasses", "unsupported_claims"],
      "properties": {
        "direct_hidden_state_reads": {"type": "integer", "minimum": 0},
        "unsupported_state_mutations": {"type": "integer", "minimum": 0},
        "canary_uses": {"type": "integer", "minimum": 0},
        "invariant_bypasses": {"type": "integer", "minimum": 0},
        "unsupported_claims": {"type": "integer", "minimum": 0}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm_id", "episode_id", "event_id", "provider_response", "provider_error", "action_match", "citation_supported", "mutation_applied", "receipt_sha256"],
        "properties": {
          "arm_id": {"type": "string"},
          "episode_id": {"type": "string"},
          "event_id": {"type": "string"},
          "provider_response": {},
          "provider_error": {"type": ["string", "null"]},
          "action_match": {"type": "boolean"},
          "citation_supported": {"type": "boolean"},
          "mutation_applied": {"type": "boolean"},
          "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "provider_calls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "job_id", "evaluation_seed", "arm_id", "episode_id", "event_id", "request_sha256", "response_sha256", "evaluator_request_sha256", "wire_request", "wire_request_sha256", "parsed_response_sha256", "raw_response_b64", "raw_response_sha256", "provider_request_id", "attempts", "http_statuses", "latency_ms", "prompt_tokens", "completion_tokens", "total_tokens", "status"],
        "properties": {
          "schema": {"const": "cleanroom.provider-call-telemetry/v1"},
          "job_id": {"pattern": "^[0-9a-f]{64}$"},
          "evaluation_seed": {"type": "integer"},
          "arm_id": {"type": "string"},
          "episode_id": {"type": "string"},
          "event_id": {"type": "string"},
          "request_sha256": {"pattern": "^[0-9a-f]{64}$"},
          "response_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "evaluator_request_sha256": {"pattern": "^[0-9a-f]{64}$"},
          "wire_request": {"type": "object"},
          "wire_request_sha256": {"pattern": "^[0-9a-f]{64}$"},
          "parsed_response_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "raw_response_b64": {"type": ["string", "null"]},
          "raw_response_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "provider_request_id": {"type": ["string", "null"]},
          "attempts": {"type": "integer", "minimum": 1},
          "http_statuses": {"type": "array", "minItems": 1, "items": {"type": ["integer", "string"]}},
          "latency_ms": {"type": "integer", "minimum": 0},
          "prompt_tokens": {"type": "integer", "minimum": 0},
          "completion_tokens": {"type": "integer", "minimum": 0},
          "total_tokens": {"type": "integer", "minimum": 0},
          "status": {"enum": ["PASS", "FAIL"]},
          "failure_class": {"type": "string"}
        }
      }
    },
    "receipt_sha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}

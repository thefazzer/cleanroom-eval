{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finexhaust.example/schemas/cleanroom-citation-task-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "question", "evidence"],
  "properties": {
    "schema": {"const": "cleanroom.citation-task/v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "question": {"type": "string", "minLength": 1, "maxLength": 16384},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "object"}
    }
  }
}

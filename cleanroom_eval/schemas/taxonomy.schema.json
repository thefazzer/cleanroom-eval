{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finexhaust.example/schemas/cleanroom-taxonomy-v1",
  "title": "Clean-room capital-markets-operations competency taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "classification",
    "scope",
    "tool_surfaces",
    "competencies"
  ],
  "properties": {
    "schema": {"const": "cleanroom.competency-taxonomy/v1"},
    "version": {"pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "FROZEN"},
    "classification": {"const": "CLEANROOM_SYNTHETIC"},
    "scope": {"type": "string", "minLength": 40},
    "tool_surfaces": {
      "type": "array",
      "minItems": 5,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "contract"],
        "properties": {
          "id": {"pattern": "^[a-z][a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 2},
          "contract": {"type": "string", "minLength": 20}
        }
      }
    },
    "competencies": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "definition",
          "observable_outcomes",
          "failure_modes"
        ],
        "properties": {
          "id": {"pattern": "^cmo\\.[a-z0-9_.]+$"},
          "name": {"type": "string", "minLength": 3},
          "definition": {"type": "string", "minLength": 30},
          "observable_outcomes": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 10}
          },
          "failure_modes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 8}
          }
        }
      }
    }
  }
}


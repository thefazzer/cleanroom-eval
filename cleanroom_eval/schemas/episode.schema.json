{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finexhaust.example/schemas/cleanroom-episode-v1",
  "title": "Clean-room long-horizon episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adversarial_mutations",
    "authorization",
    "classification",
    "competencies",
    "entities",
    "episode_id",
    "events",
    "evidence_challenges",
    "final_state",
    "initial_state",
    "partition",
    "reward_traps",
    "scenario_lineage",
    "schema",
    "template_family",
    "time_window",
    "title",
    "tool_surfaces",
    "transfer_tags",
    "world_id"
  ],
  "properties": {
    "schema": {
      "const": "cleanroom.capital-markets-episode/v1"
    },
    "episode_id": {
      "pattern": "^episode_[a-z0-9_]+_v1$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "classification": {
      "const": "CLEANROOM_SYNTHETIC"
    },
    "world_id": {
      "pattern": "^world_eval_[a-z0-9_]+$"
    },
    "template_family": {
      "pattern": "^eval_[a-z0-9_]+$"
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "competencies": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "pattern": "^cmo\\.[a-z0-9_.]+$"
      }
    },
    "tool_surfaces": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "pattern": "^[a-z][a-z0-9_]+$"
      }
    },
    "entities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "pattern": "^syn_[a-z0-9_]+$"
          },
          "kind": {
            "enum": [
              "person",
              "organisation",
              "account",
              "product",
              "trade",
              "case",
              "system",
              "instrument"
            ]
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "initial_state": {
      "$ref": "#/$defs/state_records"
    },
    "events": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "final_state": {
      "$ref": "#/$defs/state_records"
    },
    "reward_traps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trap_id",
          "description",
          "detector"
        ],
        "properties": {
          "trap_id": {
            "pattern": "^trap_[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 15
          },
          "detector": {
            "enum": [
              "canary_use",
              "unsupported_claim",
              "unauthorized_mutation",
              "unsupported_state_mutation",
              "hidden_state_read",
              "invariant_bypass"
            ]
          }
        }
      }
    },
    "transfer_tags": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "pattern": "^[a-z][a-z0-9_]+$"
      }
    },
    "partition": {
      "const": "SEALED_TEST"
    },
    "scenario_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_family",
        "entity_namespace",
        "render_seed_family",
        "source_basis",
        "restricted_source_inputs"
      ],
      "properties": {
        "scenario_family": {
          "pattern": "^sealed_[a-z0-9_]+$"
        },
        "entity_namespace": {
          "pattern": "^syn_eval_[a-z0-9_]+$"
        },
        "render_seed_family": {
          "pattern": "^sealed_seed_[a-z0-9_]+$"
        },
        "source_basis": {
          "const": "GENERAL_DOMAIN_EXPERTISE"
        },
        "restricted_source_inputs": {
          "const": 0
        }
      }
    },
    "evidence_challenges": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id",
          "claim",
          "required_evidence_refs",
          "supplied_evidence_refs",
          "expected_disposition"
        ],
        "properties": {
          "challenge_id": {
            "pattern": "^challenge_[a-z0-9_]+$"
          },
          "claim": {
            "type": "string",
            "minLength": 20
          },
          "required_evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "pattern": "^evidence_[a-z0-9_]+$"
            }
          },
          "supplied_evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "pattern": "^evidence_[a-z0-9_]+$"
            }
          },
          "expected_disposition": {
            "enum": [
              "SUPPORTED",
              "REFUSE_UNSUPPORTED"
            ]
          }
        }
      }
    },
    "adversarial_mutations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mutation_id",
          "description",
          "patch",
          "expected_error"
        ],
        "properties": {
          "mutation_id": {
            "pattern": "^mutation_[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "patch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "path",
              "value"
            ],
            "properties": {
              "op": {
                "const": "replace"
              },
              "path": {
                "pattern": "^/(events|initial_state|final_state)/"
              },
              "value": {}
            }
          },
          "expected_error": {
            "enum": [
              "unauthorized action",
              "invalid mutation precondition/version",
              "non-monotonic sequence/time",
              "unbalanced ledger entries",
              "event lacks evidence refs",
              "request id reused without duplicate_of",
              "ledger entry references unknown object",
              "replayed final state differs"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "state_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "state",
          "version"
        ],
        "properties": {
          "object_id": {
            "pattern": "^syn_[a-z0-9_]+$"
          },
          "state": {
            "type": "string",
            "minLength": 2
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "facts": {
            "type": "object"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_id",
        "at",
        "surface",
        "actor_id",
        "action",
        "request_id",
        "expected_receipt",
        "observation",
        "evidence_refs",
        "mutations"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_id": {
          "pattern": "^evt_[a-z0-9_]+$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "surface": {
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "actor_id": {
          "pattern": "^syn_[a-z0-9_]+$"
        },
        "action": {
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "request_id": {
          "pattern": "^req_[a-z0-9_]+$"
        },
        "expected_receipt": {
          "pattern": "^rcpt_[a-z0-9_]+$"
        },
        "observation": {
          "type": "string",
          "minLength": 20
        },
        "duplicate_of": {
          "pattern": "^evt_[a-z0-9_]+$"
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "pattern": "^evidence_[a-z0-9_]+$"
          }
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_id",
              "from_state",
              "to_state",
              "from_version",
              "to_version"
            ],
            "properties": {
              "object_id": {
                "pattern": "^syn_[a-z0-9_]+$"
              },
              "from_state": {
                "type": "string"
              },
              "to_state": {
                "type": "string"
              },
              "from_version": {
                "type": "integer",
                "minimum": 0
              },
              "to_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "ledger_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "account_id",
              "currency",
              "amount_minor"
            ],
            "properties": {
              "account_id": {
                "pattern": "^syn_[a-z0-9_]+$"
              },
              "currency": {
                "pattern": "^[A-Z]{3}$"
              },
              "amount_minor": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
